# ─────────────────────────────────────────────────────────────────────────────
# Storefront — environment / secrets
# Copy to .env and fill in. EVERY external service is OPTIONAL in Phase 1:
# if a key is absent the corresponding adapter falls back to a deterministic
# MOCK so the whole pipeline runs offline end-to-end. Add a key → that adapter
# goes live with no code change.
# ─────────────────────────────────────────────────────────────────────────────

# --- Datastore -------------------------------------------------------------
# SQLite path for the first local run. Swap to a postgres:// URL later.
DATABASE_URL=sqlite:./data/storefront.db

# --- Discovery & audit (Stage 1–2) ----------------------------------------
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# --- Demo copy + outreach drafting (Stage 3–4) -----------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Demo hosting (Stage 3) ------------------------------------------------
# Provide VERCEL_TOKEN to deploy real preview demos; otherwise demos render to
# ./demos-out and are served locally by the worker.
VERCEL_TOKEN=
# Only needed when the token belongs to a Vercel team scope:
VERCEL_TEAM_ID=
# NETLIFY_AUTH_TOKEN=

# --- Email send (Stage 7) --------------------------------------------------
# Provider: resend | postmark | ses | mock  (defaults to mock if key absent)
EMAIL_PROVIDER=mock
EMAIL_PROVIDER_API_KEY=
# Signing secret for the Resend inbound/bounce webhook (whsec_...). When set,
# POST /webhooks/resend rejects unsigned payloads.
RESEND_WEBHOOK_SECRET=

# --- SMS "text the demo" (Phase 3, none-segment) ----------------------------
# Twilio credentials; without them the SMS adapter writes to data/sms-outbox.
# TCPA: approval of every SMS requires a documented consent basis, and STOP
# replies are honored permanently.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DAILY_CAP=10
# Local-time send window for texts (TCPA quiet hours):
SMS_QUIET_START_HOUR=20
SMS_QUIET_END_HOUR=9
SMS_TZ_OFFSET_HOURS=-5

# --- Close & convert (Phase 3) -----------------------------------------------
# Stripe secret key: enables real payment links (customer-initiated payment
# only — the system can never charge a card itself).
STRIPE_API_KEY=
PROPOSAL_PRICE_CENTS=150000
PROPOSAL_MONTHLY_CENTS=5000
PROPOSAL_CURRENCY=usd

# ─────────────────────────────────────────────────────────────────────────────
# Sender identity — the PARENT is the legal sender. Stamped on every message.
# CAN-SPAM requires a real physical mailing address.
# ─────────────────────────────────────────────────────────────────────────────
SENDER_NAME=Jane Parent
SENDER_BUSINESS=Storefront Web Studio
MAILING_ADDRESS=123 Main St, Suite 4, Fort Worth, TX 76102
REPLY_TO=jane@storefrontstudio.com
FROM_DOMAIN=outreach.storefrontstudio.com

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline policy
# ─────────────────────────────────────────────────────────────────────────────
DAILY_SEND_CAP=15
FOLLOWUP_DAYS=4
DEMO_TTL_DAYS=14

# Base domain for temp demo subdomains, e.g. joes-barbershop.demo.<BASE>
DEMO_BASE_DOMAIN=demo.storefrontstudio.com

# Worker HTTP API (dashboard talks to this)
WORKER_PORT=8787
# Public URL of the worker in production (unsubscribe links, beacons, proposals)
WORKER_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Security & production (Phase E). ALL required when NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────
# Operator password for the dashboard + API. Unset = auth disabled (dev only).
DASHBOARD_PASSWORD=
# Secret for signing session tokens (defaults to the password if unset).
AUTH_SESSION_SECRET=
# HMAC secret for unsubscribe links (uses a dev default if unset).
UNSUBSCRIBE_SECRET=
# Restrict CORS to the deployed dashboard origin (default: *)
DASHBOARD_ORIGIN=
# API rate limit, requests/minute/IP:
API_RATE_LIMIT_PER_MINUTE=120
# In-process scheduler (hourly unpublish + sequence runner, daily digest).
# Set 0 if an external cron hits POST /api/jobs/* instead.
ENABLE_SCHEDULER=1

# --- Deliverability warm-up -------------------------------------------------
# Optional ramp that LOWERS the daily cap while the sending domain warms up.
# Weekly caps from the start date; the last value holds. Never raises the cap.
SEND_WARMUP_START=
SEND_WARMUP_RAMP=5,10,15,25

# --- Observability ----------------------------------------------------------
# Generic webhook (Slack-compatible {text}) for error alerts + daily digest:
ALERT_WEBHOOK_URL=

# --- Postgres (production datastore) ----------------------------------------
# Point DATABASE_URL at Postgres to switch drivers (SQLite stays the default):
#   DATABASE_URL=postgres://user:pass@host/db
# One-time data migration from SQLite: set POSTGRES_URL and run `pnpm migrate:pg`.
POSTGRES_URL=
