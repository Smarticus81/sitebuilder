# ─────────────────────────────────────────────────────────────────────────────
# Storefront — environment / secrets
# Copy to .env and fill in. EVERY external service is OPTIONAL in Phase 1:
# if a key is absent the corresponding adapter falls back to a deterministic
# MOCK so the whole pipeline runs offline end-to-end. Add a key → that adapter
# goes live with no code change.
# ─────────────────────────────────────────────────────────────────────────────

# --- Datastore -------------------------------------------------------------
# SQLite path for the first local run. Swap to a postgres:// URL later.
DATABASE_URL=sqlite:./data/storefront.db

# --- Discovery & audit (Stage 1–2) ----------------------------------------
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# --- Demo copy + outreach drafting (Stage 3–4) -----------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Demo hosting (Stage 3) ------------------------------------------------
# Provide VERCEL_TOKEN to deploy real preview demos; otherwise demos render to
# ./demos-out and are served locally by the worker.
VERCEL_TOKEN=
# Only needed when the token belongs to a Vercel team scope:
VERCEL_TEAM_ID=
# NETLIFY_AUTH_TOKEN=

# --- Email send (Stage 7) --------------------------------------------------
# Provider: resend | postmark | ses | mock  (defaults to mock if key absent)
EMAIL_PROVIDER=mock
EMAIL_PROVIDER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Sender identity — the PARENT is the legal sender. Stamped on every message.
# CAN-SPAM requires a real physical mailing address.
# ─────────────────────────────────────────────────────────────────────────────
SENDER_NAME=Jane Parent
SENDER_BUSINESS=Storefront Web Studio
MAILING_ADDRESS=123 Main St, Suite 4, Fort Worth, TX 76102
REPLY_TO=jane@storefrontstudio.com
FROM_DOMAIN=outreach.storefrontstudio.com

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline policy
# ─────────────────────────────────────────────────────────────────────────────
DAILY_SEND_CAP=15
FOLLOWUP_DAYS=4
DEMO_TTL_DAYS=14

# Base domain for temp demo subdomains, e.g. joes-barbershop.demo.<BASE>
DEMO_BASE_DOMAIN=demo.storefrontstudio.com

# Worker HTTP API (dashboard talks to this)
WORKER_PORT=8787
